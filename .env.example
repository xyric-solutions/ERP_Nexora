NODE_ENV=development
APP_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=4000
API_EXPOSE_PORT=4000
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
API_TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://nexora_app:<url-encoded-app-password>@postgres:5432/nexora
DATABASE_MIGRATION_URL=postgresql://nexora_migrator:<url-encoded-migration-password>@postgres:5432/nexora
# Keep false by default. Apply reviewed source-ledger migrations explicitly or
# enable only during a controlled deployment against a verified backup/clone.
DATABASE_AUTO_MIGRATE=false
REDIS_URL=redis://redis:6379
AUTH_THROTTLE_SECRET=<set-authentication-throttle-hmac-secret-minimum-32-characters>
AUTH_LOGIN_DIRECTORY_SECRET=<set-login-directory-hmac-secret-minimum-32-characters>
AUTH_SESSION_SECRET=<set-session-hmac-secret-minimum-32-characters>
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
METRICS_BEARER_TOKEN=<set-metrics-bearer-token-minimum-32-characters>
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nexora-private
S3_ACCESS_KEY_ID=<set-local-access-key>
S3_SECRET_ACCESS_KEY=<set-local-secret-key>
POSTGRES_BOOTSTRAP_PASSWORD=<set-bootstrap-database-password>
POSTGRES_MIGRATION_PASSWORD=<set-migration-database-password>
POSTGRES_APP_PASSWORD=<set-application-database-password>
POSTGRES_EXPOSE_PORT=55435
REDIS_EXPOSE_PORT=56380
MINIO_API_EXPOSE_PORT=59000
MINIO_CONSOLE_EXPOSE_PORT=59001
MINIO_ROOT_USER=<set-local-minio-user>
MINIO_ROOT_PASSWORD=<set-local-minio-password>
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_EXPOSE_PORT=3000
LOG_LEVEL=info
