NODE_ENV=development
APP_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=4000
API_EXPOSE_PORT=4000
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001, http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
API_TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://nexora_app:<url-encoded-app-password>@postgres:5432/nexora
DATABASE_MIGRATION_URL=postgresql://nexora_migrator:<url-encoded-migration-password>@postgres:5432/nexora
# Keep false by default. Apply reviewed source-ledger migrations explicitly or
# enable only during a controlled deployment against a verified backup/clone.
DATABASE_AUTO_MIGRATE=false
REDIS_URL=redis://redis:6379
AUTH_THROTTLE_SECRET=<set-authentication-throttle-hmac-secret-minimum-32-characters>
AUTH_LOGIN_DIRECTORY_SECRET=<set-login-directory-hmac-secret-minimum-32-characters>
AUTH_SESSION_SECRET=<set-session-hmac-secret-minimum-32-characters>
BANKING_DATA_ENCRYPTION_KEY=<set-base64-encoded-32-byte-banking-encryption-key>
BANKING_DATA_ENCRYPTION_KEY_VERSION=v1
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
METRICS_BEARER_TOKEN=<set-metrics-bearer-token-minimum-32-characters>
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nexora-private
S3_ACCESS_KEY_ID=<set-local-access-key>
S3_SECRET_ACCESS_KEY=<set-local-secret-key>
S3_FORCE_PATH_STYLE=true
BANK_STATEMENT_CLEANUP_EVERY_MS=3600000
BANK_STATEMENT_ORPHAN_GRACE_MS=86400000
BANK_STATEMENT_CLEANUP_PAGE_SIZE=100
BANK_STATEMENT_CLEANUP_MAX_OBJECTS=1000
BANK_REVALUATION_REVERSAL_ACTOR_ID=
BANK_REVALUATION_REVERSAL_WORKER_ID=
BANK_REVALUATION_REVERSAL_EVERY_MS=60000
BANK_REVALUATION_REVERSAL_TENANT_LIMIT=1000
BANK_REVALUATION_REVERSAL_CLAIM_LIMIT=50
BANK_REVALUATION_REVERSAL_CLAIM_LEASE_MS=300000
BANK_REVALUATION_REVERSAL_RETRY_BASE_MS=30000
BANK_REVALUATION_REVERSAL_RETRY_MAXIMUM_MS=3600000
# Credential email is opt-in. Use the same 32-byte base64 encryption key in API and worker.
# Set the worker provider to resend or smtp. Compose can use its local Mailpit SMTP sink.
CREDENTIAL_EMAIL_ENABLED=false
CREDENTIAL_EMAIL_ORIGIN=http://localhost:3000
CREDENTIAL_EMAIL_ENCRYPTION_KEY=
CREDENTIAL_EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nexora@localhost
MAILPIT_SMTP_EXPOSE_PORT=51025
MAILPIT_UI_EXPOSE_PORT=58025
POSTGRES_BOOTSTRAP_PASSWORD=<set-bootstrap-database-password>
POSTGRES_MIGRATION_PASSWORD=<set-migration-database-password>
POSTGRES_APP_PASSWORD=<set-application-database-password>
POSTGRES_EXPOSE_PORT=55435
REDIS_EXPOSE_PORT=56380
MINIO_API_EXPOSE_PORT=59000
MINIO_CONSOLE_EXPOSE_PORT=59001
MINIO_ROOT_USER=<set-local-minio-user>
MINIO_ROOT_PASSWORD=<set-local-minio-password>
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_EXPOSE_PORT=3000
LOG_LEVEL=info

# Operator-only tenant bootstrap. Run the compiled bootstrap-tenant command explicitly.
NEXORA_BOOTSTRAP_ENABLED=false
NEXORA_BOOTSTRAP_TENANT_ID=
NEXORA_BOOTSTRAP_ORGANISATION_NAME=
NEXORA_BOOTSTRAP_ORGANISATION_TYPE=other
NEXORA_BOOTSTRAP_COUNTRY_CODE=
NEXORA_BOOTSTRAP_FINANCIAL_YEAR_START_MONTH=
NEXORA_BOOTSTRAP_ADMIN_FULL_NAME=
NEXORA_BOOTSTRAP_ADMIN_EMAIL=
NEXORA_BOOTSTRAP_ADMIN_USERNAME=
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=
