{
  "name": "nexora-hr-payroll",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "server/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:web": "npm run dev",
    "dev:api": "npm run dev --workspace @nexora/api",
    "dev:worker": "npm run dev --workspace @nexora/worker",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:web": "npm run start",
    "start:api": "npm run start --workspace @nexora/api",
    "start:worker": "npm run start --workspace @nexora/worker",
    "format": "prettier --write \"app/**/*.{ts,tsx,json}\" \"server/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/{unit,integration,contract,security,performance,e2e}/**/*.{ts,tsx}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,json}\" \"server/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/{unit,integration,contract,security,performance,e2e}/**/*.{ts,tsx}\" \"*.{ts,json}\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage --ignore-pattern playwright-report --ignore-pattern test-results",
    "typecheck": "tsc -b --pretty false packages/contracts packages/observability packages/auth packages/db packages/domain packages/testing server/api server/worker && tsc --noEmit --pretty false",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "cross-env TEST_SOURCE_DATABASE_URL=postgresql://nexora@127.0.0.1:55433/nexora_source_test TEST_SOURCE_BOOTSTRAP_DATABASE_URL=postgresql://nexora@127.0.0.1:55433/nexora_source_test TEST_SOURCE_REDIS_URL=redis://127.0.0.1:56380 vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "test:a11y": "npm run legacy:build && node --test tests/accessibility.test.mjs",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:performance": "cross-env TEST_SOURCE_BOOTSTRAP_DATABASE_URL=postgresql://nexora@127.0.0.1:55433/nexora_source_test vitest run --config vitest.performance.config.ts",
    "test:legacy": "npm run legacy:build && node --test \"tests/**/*.test.mjs\"",
    "test": "npm run build && npm run format:check && npm run lint && npm run test:unit && npm run test:contract && npm run test:security && npm run legacy:build && node --test \"tests/**/*.test.mjs\"",
    "db:migrate": "npm run db:migrate --workspace @nexora/db",
    "db:migrate:source": "npm run db:migrate:source --workspace @nexora/db",
    "db:migrate:test": "npm run db:migrate:test --workspace @nexora/db",
    "auth:backfill-login-directory": "npm run auth:backfill-login-directory --workspace @nexora/db",
    "auth:backfill-user-company-access": "npm run auth:backfill-user-company-access --workspace @nexora/db",
    "uat:provision-c4-auth": "tsx scripts/provision-c4-uat-auth.ts",
    "uat:provision-bank-payments": "tsx scripts/provision-bank-payments-uat.ts",
    "uat:provision-user-management": "tsx scripts/provision-user-management-uat.ts",
    "uat:provision-shoaib-admin": "tsx scripts/provision-shoaib-admin.ts",
    "api:generate": "npm run api:generate --workspace @nexora/contracts",
    "api:check": "npm run api:check --workspace @nexora/contracts",
    "catalogue:generate": "node scripts/generate-prototype-manifest.mjs",
    "catalogue:check": "node scripts/generate-prototype-manifest.mjs --check",
    "legacy:dev": "vinext dev",
    "legacy:build": "vinext build",
    "legacy:start": "vinext start",
    "payroll:publish": "node server/api/dist/cli/publish-payroll-pack.js",
    "local:api": "node scripts/run-local.mjs api",
    "local:web": "node scripts/run-local.mjs web",
    "local:worker": "node scripts/run-local.mjs worker"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@nexora/contracts": "0.1.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.8",
    "@openai/sites-vite-plugin": "0.1.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "4.10.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.0",
    "react-server-dom-webpack": "19.3.0",
    "supertest": "7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "5.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
